# Universal Knowledge MCP — copy to .env and fill in real values. Never commit .env.

# --- Required -----------------------------------------------------------------
# One PostgreSQL database holds everything (all users, clients, and namespaces).
DATABASE_URL=postgres://ukm:change_me@localhost:5432/knowledge

# Bootstrap/admin bearer token (min. 32 chars). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# --- Core settings --------------------------------------------------------------
MCP_SERVER_PORT=3000
KNOWLEDGE_NAMESPACE=default
# private | shared   (public can only be chosen explicitly by an admin)
DEFAULT_VISIBILITY=private
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Optional (defaults shown) -----------------------------------------------------
# Identity bound to MCP_AUTH_TOKEN (created automatically as an admin).
# MCP_AUTH_USER_ID=owner
# MCP_AUTH_ORG_ID=default
# stdio only: act as a specific user instead of the bootstrap admin (ukm_... token).
# MCP_USER_TOKEN=
# MCP_HOST=127.0.0.1                 # use 0.0.0.0 inside containers / PaaS
# MCP_HTTP_SESSIONS=stateful         # stateless survives restarts/cold starts better
# SESSION_IDLE_TIMEOUT_MINUTES=30
# ALLOWED_ORIGINS=                   # comma-separated browser origins; empty = reject browser origins
# TRUST_PROXY=false                  # true behind a reverse proxy that sets X-Forwarded-*
# REQUIRE_HTTPS=false                # true in production behind a TLS-terminating proxy
# RATE_LIMIT_PER_MINUTE=120
# REQUEST_TIMEOUT_MS=30000
# TOOL_TIMEOUT_MS=20000
# MAX_REQUEST_BYTES=1048576
# DATABASE_SSL=auto                  # auto | disable | require | no-verify
# DB_POOL_MAX=5                      # keep low on free database tiers
# DB_QUERY_TIMEOUT_MS=15000
# AUTO_MIGRATE=false                 # run migrations on startup (handy on PaaS without a release step)
# SEARCH_DEFAULT_LIMIT=5
# SEARCH_MAX_LIMIT=20
# SEARCH_MIN_SCORE=0.15
# SEARCH_CACHE_TTL_SECONDS=60
# SEARCH_CACHE_MAX_ENTRIES=500
# DUPLICATE_SIMILARITY_THRESHOLD=0.6
# STALE_AFTER_DAYS=365
# ARCHIVE_RETENTION_DAYS=30          # archived documents are purged after this many days (0 = never)
# AUDIT_RETENTION_DAYS=180
# MAX_DOCUMENT_BYTES=102400
# REDACT_EMAILS=true

# --- Optional semantic search (pgvector + any OpenAI-compatible embeddings endpoint) ---
# Works with free local models, e.g. Ollama: EMBEDDINGS_URL=http://localhost:11434/v1
# EMBEDDINGS_URL=
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_TIMEOUT_MS=5000
